# CODEUP ENVIRONMENT CONFIG

# Flask
FLASK_SECRET_KEY=change-me-in-production

# Primary AI provider (Groq, free tier at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
# Master switch. Set to 0 to disable cloud AI (variable name kept for backward compat)
GEMINI_ENABLED=1

# OFFLINE AI FALLBACK (OLLAMA)
# Install Ollama from https://ollama.com, then pull a small model: ollama pull llama3.2:3b
OLLAMA_ENABLED=0
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
