FLASK_SECRET_KEY=change-me-in-production

# Either form works, and both can be used together (deduplicated automatically):
# GROQ_API_KEYS is a single comma-separated list, e.g. key1,key2,key3
GROQ_API_KEYS=
# ...or the original numbered form (still fully supported):
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_2=your_second_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
# 0 = disable all cloud AI
GEMINI_ENABLED=1

# Groq key-pool tuning (codeup/providers/groq_pool.py) - safe defaults below.
# How many requests one key may run at the same time.
GROQ_MAX_CONCURRENCY_PER_KEY=1
# Bounded FIFO queue size once every key is at capacity.
GROQ_QUEUE_MAX_SIZE=100
# Seconds a request will wait in that queue before giving up.
GROQ_QUEUE_WAIT_TIMEOUT=45
# Run a real (tiny) health-check request against every configured key at
# process startup. Off by default - costs real API quota, and health is
# otherwise inferred from live traffic. Prefer `python scripts/check_groq_keys.py`.
GROQ_HEALTH_CHECK_ON_STARTUP=0

OLLAMA_ENABLED=0
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
