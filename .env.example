# ============================================
# CodeUp Configuration
# ============================================

# Gemini API Configuration
# Get your API key from: https://ai.google.dev/
# 1. Visit https://ai.google.dev/
# 2. Click "Get API Key" 
# 3. Create a new API key
# 4. Copy the key and set it below
GEMINI_API_KEY=Insert_API_Key_Here

# Enable/Disable Gemini AI features
# Set to "1" to enable, "0" to disable
GEMINI_ENABLED=1

# Execution timeout in seconds (default: 1.0)
EXECUTION_TIME_LIMIT=1.0

# Data directory for storing snippets
DATA_DIR=.

# Snippets file name
SNIPPETS_FILE=snippets.json

# Optional: Use subprocess sandbox for code execution
# Set to "1" to run user code in isolated subprocess
USE_SUBPROCESS_SANDBOX=0

# ============================================
# Quick Start
# ============================================
# 1. Copy this file to .env
# 2. Replace "Insert_API_Key_Here" with your actual Gemini API key
# 3. Run: pip install -r requirements.txt
# 4. Run: python app.py
# 5. Open http://127.0.0.1:5000 in your browser
# 6. Select your preferred language (English or Hindi) from the dropdown

# For Hindi Support:
# - All AI functions will provide responses in Hindi
# - Text-to-speech will pronounce Hindi text
# - Select "हिंदी (Hindi)" from the language dropdown in the UI